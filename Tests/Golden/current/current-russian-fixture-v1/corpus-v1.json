      "categories": [
        "production_like",
        "yo_e"
      ],
      "id": "narrative-013",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "Радио поймало далёкий шёпот."
    },
    {
      "categories": [
        "production_like"
      ],
      "id": "narrative-014",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "Вода под мостом внезапно замерла."
