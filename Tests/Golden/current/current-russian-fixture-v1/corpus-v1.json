      "id": "narrative-001",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "На лестнице погас свет, и шаги стали ближе."
    },
    {
      "categories": [
        "production_like",
        "negation"
      ],
      "id": "narrative-002",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "За окном качнулась ветка, хотя ветра не было."
    },
    {
      "categories": [
        "production_like"
      ],
      "id": "narrative-003",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "Письмо лежало на столе без подписи."
    },
    {
      "categories": [
        "production_like"
      ],
      "id": "narrative-004",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "Лифт остановился между этажами."
    },
    {
      "categories": [
        "production_like"
      ],
      "id": "narrative-005",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "Телефон зазвонил в пустой комнате."
    },
    {
      "categories": [
        "production_like"
      ],
      "id": "narrative-006",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "В коридоре появилась новая дверь."
    },
    {
      "categories": [
        "production_like"
      ],
      "id": "narrative-007",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "Часы пробили тринадцать раз."
    },
    {
      "categories": [
        "production_like",
        "yo_e"
      ],
      "id": "narrative-008",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "Собака смотрела в тёмный угол."
    },
    {
      "categories": [
        "production_like"
      ],
      "id": "narrative-009",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "На снегу виднелась одна цепочка следов."
    },
    {
      "categories": [
        "production_like",
        "yo_e"
      ],
      "id": "narrative-010",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "Ключ подошёл к старому замку."
    },
    {
      "categories": [
        "production_like"
      ],
      "id": "narrative-011",
      "languageHint": "ru",
      "source": "authored-sanitized",
      "text": "Герой спрятал карту и продолжил путь."
